# Compose environment — copy to .env, which is git-ignored.
#
#   cp .env.example .env
#
# The two values below have no default on purpose: docker compose refuses to
# start until they are set, so a real deployment cannot inherit a password that
# was published in this repository. Generate them:
#
#   printf 'POSTGRES_PASSWORD=%s\nSECRET_KEY=%s\n' \
#     "$(openssl rand -hex 16)" "$(openssl rand -hex 32)" >> .env

POSTGRES_PASSWORD=
SECRET_KEY=

# ------------------------------------------------------------------ optional
# Defaults are applied by docker-compose.yml when these are left unset.

# POSTGRES_USER=interview
# POSTGRES_DB=interview_scheduler
# ENVIRONMENT=development

# Bootstrap administrator, created on first start. Change both before exposing
# the stack to anyone — see SECURITY.md.
# FIRST_ADMIN_EMAIL=admin@example.com
# FIRST_ADMIN_PASSWORD=
